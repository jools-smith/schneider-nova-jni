declare.snif.initialize = { 
	["predicate"] = "do_initialize",
	["on_false"] = "do_initialize_fail",
	["on_true"] = "do_initialize_success", 
	["detect_tamper"] = true, 
	["aliases"] = 2
}

options.one_pass = false

options.debug = {
    ["stats"] = true, 
    ["trace"] = true,
    ["allow_debugger"] = false,
    ["allow_failure"] = false, 
    ["visual_studio"] = false, 
    ["enc_trace"] = false, 

    ["dump_mismatched_sections"] = true
}

options.verify_modules = {
	["linux"] = {
		["checksum"] = true,
		["lazy"] = true,
		["target"] = "FlxCore.2024.11"
	}
}

options.header = "Nova Demo (c) 2026 Jools Smith"

options.name = "nova"

options.TDT = { ["typename"] = "TFT" }

options.script = "nova_script"

options.register = {	
	"do_initialize", 
	"do_initialize_fail", 
	"do_initialize_success",
	"cf_tamper_detected",
	"cf_save_jni_field_aliases_good",
	"cf_save_jni_field_aliases_bad"
}

options.callhome = "cf_tamper_detected"

